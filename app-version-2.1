private void handleStatus(String status, String telegram) {

    switch (NEW_VERSION_AVAILABLE) {

        case "UNDER_CONSTRUCTION":
            showUnderConstruction(telegram);
            break;

        case "SERVER_DOWN":
            showServerDown(telegram);
            break;

        case "NEW_VERSION_AVAILABLE":
            showUpdateRequired(https://store-eu-par-5.gofile.io/download/web/f206c0d8-26b3-4fca-892f-91f85faa72ed/com.turbotv.app_v1.apk);
            break;

        case "ACTIVE":
            handleActive();
            break;

        default:
            showServerDown(telegram);
            break;
    }
}
